# Database
# For local development (direct connection)
DATABASE_URL=postgresql://your_user:your_password@your_host/your_database?sslmode=require

# For Production/Vercel with connection pooling (RECOMMENDED)
# DATABASE_URL=postgresql://your_user:your_password@pgbouncer-host:6432/your_database?sslmode=require

# Alternative: Prisma Data Proxy (no pooling needed)
# DATABASE_URL=prisma://aws-xxxxx.prisma-data.com/?api_key=xxxxx

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Node Environment
NODE_ENV=development

# Optional: Memory limit for serverless (MB)
# NODE_OPTIONS=--max-old-space-size=512

# Optional: Prisma debug mode
# DEBUG=prisma:*
